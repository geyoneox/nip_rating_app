            {"name": "pd_make", "type": "string"},
            {"name": "pd_model", "type": "string"},
            {"name": "pd_year", "type": "string"},
            {"name": "vehicle_type", "type": "string"},
            {"name": "vehicle_subtype", "type": "string"},
            {"name": "raw_result", "type": "object"},
            {"name": "validated_at", "type": "datetime"},
            {"name": "created_at", "type": "datetime", "default": "now()", "constraints": {"required": true}},
            {"name": "updated_at", "type": "datetime", "default": "now()", "constraints": {"required": true}}
          ],
          "primaryKey": ["id"],
          "foreignKeys": [
            {"fields": ["run_id"], "reference": {"resource": "nip_runs", "fields": ["id"]}, "x-actions": {"onDelete": "RESTRICT"}}
          ],
          "indexes": [
            {"name": "uq_run_vin", "fields": ["run_id", "vin"], "unique": true},
            {"name": "idx_run", "fields": ["run_id"]},
            {"name": "idx_run_success", "fields": ["run_id", "success"]}
          ]
        }
      },
